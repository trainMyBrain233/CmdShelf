# Copy to .env and fill in your local MySQL password.
# The original local profile used localhost:3306, root, and database cmdshelf.
# Do not commit .env. The app does not automatically load it.
CMDSHELF_MYSQL_HOST=localhost
CMDSHELF_MYSQL_PORT=3306
CMDSHELF_MYSQL_USER=root
CMDSHELF_MYSQL_DATABASE=cmdshelf
CMDSHELF_MYSQL_PASSWORD=replace-with-your-local-password
